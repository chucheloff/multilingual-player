#!/usr/bin/env bash
# dualplay - play a video with two audio tracks at once.
#
# Usage: dualplay [-2] [-p NAME -p NAME] [-l LANGS] [-r LANGS] FILE|FOLDER... [mpv options...]
#        dualplay -L
#   -l LANGS  languages for the left ear (with -2: first pair), e.g. "eng,en"
#   -r LANGS  languages for the right ear (with -2: second pair), e.g. "rus,ru"
#   -2        two headphone pairs: a stereo track on each, using the two
#             connected Bluetooth outputs
#   -p NAME   with -2, use this output (part of its name) instead; give it twice
#   -L        list the connected outputs (names for -p) and exit
# Without -l/-r the track that would normally play comes first, the next one second.
# A folder plays its .mkv files in episode order (not those in its subfolders).
set -euo pipefail

usage() { sed -n '4,14s/^# \{0,1\}//p' "$0"; exit "${1:-0}"; }

left="" right="" pairs="" list="" names=()
while getopts "l:r:2p:Lh" opt; do
  case $opt in
    l) left=$OPTARG ;;
    r) right=$OPTARG ;;
    2) pairs=1 ;;
    p) names+=("$OPTARG") ;;
    L) list=1 ;;
    h) usage ;;
    *) usage 1 ;;
  esac
done
shift $((OPTIND - 1))
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)

# The helper that finds and combines the outputs (-2, -L) is compiled on first use.
helper="$here/tools/.build/audio-pairs"
build_helper() {
  if [ ! -x "$helper" ] || [ "$here/tools/audio-pairs.swift" -nt "$helper" ]; then
    command -v swiftc >/dev/null || { echo "dualplay: -2 and -L need swiftc - xcode-select --install" >&2; exit 1; }
    mkdir -p "$here/tools/.build"
    swiftc -O -o "$helper" "$here/tools/audio-pairs.swift"
  fi
}
if [ -n "$list" ]; then build_helper; exec "$helper" list; fi

[ ${#names[@]} -eq 0 ] || [ ${#names[@]} -eq 2 ] || { echo "dualplay: give -p twice" >&2; exit 1; }

# A folder's .mkv files in episode order ("Episode 2" before "Episode 10"),
# NUL-separated. Any case of .mkv; hidden files (macOS leaves "._" copies on
# USB drives) and subfolders - extras and samples in a season folder - stay out.
mkvs() {
  local f
  shopt -s nullglob nocaseglob
  for f in "${1%/}"/*.mkv; do
    [ ! -f "$f" ] || printf '%s\0' "$f"
  done | sort -z -f -V
  shopt -u nullglob nocaseglob
}

# Files and folders come first: the first argument starting with "-" and all
# after it are mpv's. Each folder becomes its episodes, so mpv gets the whole
# playlist up front (the bubbaTV menu lists it).
files=()
while [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; do
  if [ -d "$1" ]; then
    n=${#files[@]}
    while IFS= read -r -d '' f; do files+=("$f"); done < <(mkvs "$1")
    [ ${#files[@]} -gt "$n" ] || { echo "dualplay: no .mkv files in $1 (its subfolders are not searched)" >&2; exit 1; }
  else
    files+=("$1")
  fi
  shift
done
[ ${#files[@]} -ge 1 ] || usage 1
set -- "${files[@]}" "$@"

command -v mpv >/dev/null || { echo "dualplay: mpv not found - brew install mpv" >&2; exit 1; }

scripts="${MPV_HOME:-$HOME/.config/mpv}/scripts"
# Let the video decoder use the Mac's media engine instead of competing with
# both audio decoders for CPU time. Options supplied after the files win.
args=(--hwdec=auto)
# Skip --script if the plugin is already installed, or mpv would load it twice.
[ -e "$scripts/dual_audio.lua" ] || args+=(--script="$here/scripts/dual_audio.lua")

# The bubbaTV menu is a native mpv plugin, compiled on first use against the
# headers of this mpv. Without swiftc or the headers mpv plays without it.
menu="$here/tools/.build/bubbatv.so"
build_menu() {
  local header
  header="$(dirname "$(dirname "$(readlink -f "$(command -v mpv)")")")/include/mpv/client.h"
  if ! command -v swiftc >/dev/null || [ ! -e "$header" ]; then
    echo "dualplay: no swiftc or mpv headers, so no bubbaTV menu" >&2
    return 1
  fi
  mkdir -p "$here/tools/.build"
  swiftc -O -emit-library -o "$menu" "$here/tools/bubbatv-menu.swift" -import-objc-header "$header" \
    -Xlinker -undefined -Xlinker dynamic_lookup
}
if [ ! -e "$scripts/bubbatv.so" ]; then
  if { [ -e "$menu" ] && [ ! "$here/tools/bubbatv-menu.swift" -nt "$menu" ]; } || build_menu; then
    args+=(--script="$menu")
  fi
fi
# -append takes a single pair, so commas in the language lists survive.
args+=(--script-opts-append=dual_audio-auto=yes)
[ -z "$left" ] || args+=(--script-opts-append="dual_audio-left_lang=$left")
[ -z "$right" ] || args+=(--script-opts-append="dual_audio-right_lang=$right")

[ -n "$pairs" ] || exec mpv "${args[@]}" "$@"

# Two pairs: combine both outputs into one 4-channel device for the length
# of the movie.
build_helper
info=$("$helper" create ${names[@]+"${names[@]}"})
# The script rebuilds the device with the same UID when a pair moves to other
# headphones or gets them back, so this removes whichever is there last.
trap '"$helper" destroy' EXIT
trap 'exit 130' INT TERM  # make sure Ctrl+C still runs the EXIT trap
IFS=$'\t' read -r uid first second <<<"$info"
echo "dualplay: first track -> $first, second track -> $second"

args+=(--audio-device="coreaudio/$uid" --audio-channels=quad
       --audio-buffer=0.5
       --script-opts-append=dual_audio-mode=pairs
       --script-opts-append="dual_audio-pair_names=$first|$second"
       --script-opts-append="dual_audio-helper=$helper")
mpv "${args[@]}" "$@"
